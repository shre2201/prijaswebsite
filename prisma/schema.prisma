generator client {
  provider = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum SkinType {
  OILY
  DRY
  COMBINATION
  SENSITIVE
  NORMAL
}

enum ConsultationMode {
  VIDEO
  PHONE
  IN_PERSON
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
}

enum ProductCategory {
  UNIVERSAL
  PERSONALIZED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

// ── Core tables ────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified DateTime?
  password      String?
  phone         String?
  role          Role      @default(CUSTOMER)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  bookings      Booking[]
  orders        Order[]
  blogPosts     BlogPost[]
  testimonials  Testimonial[]
  accounts      Account[]
  sessions      Session[]
}

model Profile {
  id             String     @id @default(cuid())
  userId         String     @unique
  skinType       SkinType?
  concerns       String[]
  allergies      String[]
  notes          String?
  followUpDate   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  description  String
  price        Decimal         @db.Decimal(10, 2)
  comparePrice Decimal?        @db.Decimal(10, 2)
  category     ProductCategory
  stock        Int             @default(0)
  sku          String?         @unique
  images       String[]
  isActive     Boolean         @default(true)
  isFeatured   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  ingredients  ProductIngredient[]
  orderItems   OrderItem[]
}

model Booking {
  id          String           @id @default(cuid())
  userId      String?
  // Contact details captured by the booking form (guests and signed-in users alike)
  name        String?
  email       String?
  phone       String?
  notes       String?
  date        DateTime
  timeSlot    String
  mode        ConsultationMode
  concerns    String[]
  images      String[]
  status      BookingStatus    @default(PENDING)
  adminNotes  String?
  followUpAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  total           Decimal       @db.Decimal(10, 2)
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentId       String?
  razorpayOrderId String?
  shippingAddress Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OrderItem[]
}

model BlogPost {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  content     String
  coverImage  String?
  tags        String[]
  status      BlogStatus @default(DRAFT)
  authorId    String
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  author      User       @relation(fields: [authorId], references: [id])
}

model RawMaterial {
  id                String   @id @default(cuid())
  name              String
  stock             Decimal  @db.Decimal(10, 3)
  unit              String
  lowStockThreshold Decimal  @db.Decimal(10, 3)
  supplier          String?
  costPerUnit       Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  ingredients ProductIngredient[]
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
  FOLLOWUP
}

model Testimonial {
  id        String             @id @default(cuid())
  userId    String?
  name      String
  email     String
  concern   String
  quote     String
  rating    Int
  status    TestimonialStatus  @default(PENDING)
  adminNote String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user      User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Decimal  @db.Decimal(10, 2)
  duration    Int      @default(30)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Junction tables ────────────────────────────────────────────────────────────

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([orderId, productId])
}

model ProductIngredient {
  id            String      @id @default(cuid())
  productId     String
  rawMaterialId String
  amount        Decimal     @db.Decimal(10, 3)
  unit          String

  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@unique([productId, rawMaterialId])
}

// ── NextAuth tables ────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Harsheen's own calendar entries. Same date convention as Booking (UTC-midnight date + local "HH:MM").
model CalendarEvent {
  id             String   @id @default(cuid())
  title          String
  date           DateTime
  startTime      String?  // "HH:MM", 24h; null when allDay
  endTime        String?
  allDay         Boolean  @default(false)
  notes          String?
  /// When true, the booking form won't offer slots that overlap this event.
  blocksBookings Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
}
